# Copy this file to android/keystore.properties and keep the real file private.
# Absolute paths are safest; forward slashes work on Windows, macOS, and Linux.
storeFile=C:/secure/path/wiwi-upload-key.p12
storePassword=replace-with-a-strong-password
keyAlias=wiwi-upload
keyPassword=replace-with-a-strong-password
storeType=PKCS12
