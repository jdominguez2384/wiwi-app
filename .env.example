NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Keep false until the Apple/Google products, RevenueCat offering, webhook,
# and sandbox purchase/restore tests are complete.
NEXT_PUBLIC_PRO_BILLING_ENABLED=false
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_sdk_key
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_sdk_key

# Server-only. Never expose these values through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
REVENUECAT_SECRET_API_KEY=sk_your_secret_api_key
REVENUECAT_WEBHOOK_AUTH_KEY=generate-a-long-random-secret
